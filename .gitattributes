# Saltos de línea fijos para evitar diferencias falsas entre Windows y otros sistemas (P-054).
* text=auto eol=lf

# Scripts de Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.jar binary
*.keystore binary
*.jks binary
*.zip binary
*.pdf binary
